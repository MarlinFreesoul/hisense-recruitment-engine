# 复制本文件为 .env 并填入真实凭证（.env 不入库）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
DEEPSEEK_API_KEY=sk-xxx
# 可选
# DEEPSEEK_MODEL=deepseek-chat
# TOP_N_CANDIDATES=5
# 人才储备池表（模块 4：合格候选人自动入库 + Offer 放弃秒级递补）
# 由 seed_talent_pool.py 建表后填入返回的 table_id
# TALENT_POOL_TABLE_ID=tblxxxxxxxxxxxx

# ============ 视频面试 · 腾讯云 TRTC（独立接入） ============
# TRTC 控制台「应用」页的 SDKAppID 与「密钥」(Key)，仅用于后端签发 UserSig
TRTC_APP_ID=1400000000
TRTC_SECRET_KEY=your_trtc_secret_key
# TRTC_USER_SIG_EXPIRE=86400

# ============ 独立语音识别 · 腾讯云实时语音识别 ============
# 腾讯云主账号 SecretId/SecretKey；ASR_APP_ID 为语音识别应用 AppId（≠ TRTC_APP_ID）
TENCENT_SECRET_ID=AKIDxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxx
ASR_APP_ID=1300000000
# ASR_ENGINE_MODEL=16k_zh
# ASR_VOICE_FORMAT=1

# ============ 录制存储 · 腾讯云 COS ============
COS_BUCKET=hireai-interview-1250000000
COS_REGION=ap-guangzhou
# COS_RECORD_PREFIX=interview-records/

# ============ TRTC 云端录制 + 录音文件识别（事后权威纪要） ============
# 开启后，面试结束用 TRTC 云端录制落盘 → 走 src/asr_file.py 做带说话人分离的纪要
# TRTC_RECORD_ENABLED=false
# ASR_FILE_ENGINE=16k_zh
# ASR_FILE_REGION=ap-guangzhou
# 真实联调文件识别时，把录制文件托管到公网可访问地址（或传 COS 回看链接）后提交：
# ASR_FILE_PUBLIC_URL=https://your-cdn/interview.mp3
# 云端录制机器人（进房录制用的服务端用户，后端自签 UserSig）
# TRTC_RECORD_BOT_USER=rec_bot
# 录制模式：Audio（仅音频，最省，正是 ASR 所需）/ Video / VideoAndAudio
# TRTC_RECORD_MODE=Audio
# 录制落盘：cos（腾讯云对象存储，本项目默认）/ vod（云点播）
# TRTC_RECORD_STORAGE=cos
# 录制完成回调 /video/recording/callback 的校验令牌（可选）
# VIDEO_CALLBACK_TOKEN=
# 单流分轨录制（默认开启）：不设置 MixTranscodeParams 即为单流，HR/候选人各一独立音频文件，
# 文件名含 base64(UserId)，后端按轨道直接标说话人，无需说话人分离（比合流+diarization 更稳）
# TRTC_RECORD_SINGLE_STREAM=true
# 候选人面试资格门禁必填字段（缺任一即不允许开视频房间）
# CANDIDATE_REQUIRED_FIELDS=姓名,最近职位,最近公司,工作年限

# ============ 视频面试前端页地址 ============
# VIDEO_INTERVIEW_BASE_URL=http://localhost:8000
